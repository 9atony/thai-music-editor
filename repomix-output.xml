      </div>

      <div className="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-4 md:gap-5">
        {samples.map((sample) => (
          <button 
            key={sample.id} 
            onClick={() => onOpenProject && onOpenProject(sample.id)}
